# Joetech Shops — environment variables
# Copy to .env.local and fill in. NEVER commit .env.local with real keys.

# --- Supabase (required for accounts, shops, checkout) ---
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (SECRET — server only, never expose to the browser).
# From Supabase: Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (required for card checkout) ---
# Use TEST keys first (pk_test_... / sk_test_...). Go live only after your
# CAC business registration is complete — Paystack needs it to verify you.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# --- App URL (used for the Paystack callback after payment) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
